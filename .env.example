# Copy to .env. Shared across every project this launcher runs, and handed to
# the agent's container WHOLESALE via docker-compose.yml's `env_file: - .env`
# — every key here is an environment variable the agent can read.
#
# That is why this file stays free of project-scoped secrets entirely, as a
# rule and not a reminder: a project's own credentials belong in
# projects/<name>/.env, which is read AFTER this one (last value wins), never
# in here where they would leak into every project's stack by construction.
# Concatenation is then safe because there is nothing here to leak, not
# because someone remembered to blank it.
#
# IMPORTANT: keep comments on their OWN lines, never inline after a value —
# the parser does not strip trailing comments.
#
# No SYMPHONY_* key belongs in this file. Those are the orchestrator's and
# live in symphony.env, which is never handed to the agent's container.

# === Required: LLM ===========================================================
LLM_API_BASE=https://llm.internal.example/v1
LLM_API_KEY=

# === GitLab (shared endpoint, per-project token) =============================
# Only the endpoint and your own GitLab identity are shared — GITLAB_PAT below
# is commented out here on purpose. This launcher's whole point is running
# scoped, per-project agents, so the agent's actual credential belongs in
# projects/<name>/.env: a project (or group) access token, never a personal
# PAT. See projects/_example/.env.example and the README's "The token's
# scope is the boundary".
#
# Base URL over HTTPS, no trailing slash.
GITLAB_BASE_URL=
# Your GitLab username (used for git Basic auth).
GITLAB_USER=
# GITLAB_PAT=   # set per project instead — see projects/_example/.env.example

# === Optional: other services (all per-project, see projects/_example) ======
# Every value below is set in projects/<name>/.env, never here — this file is
# the one place a leaked project credential would fan out to every stack this
# launcher runs, so it stays structurally empty of them.
# BITBUCKET_PAT=
# JIRA_PAT=
# JFROG_PAT=
# CONFLUENCE_PAT=
# MFILES_PAT=

# === Git identity (for commits made inside the container) ===================
# Leave blank to skip. If unset, commits made in the container fall back to
# whatever git defaults are available there.
GIT_USER_NAME=
GIT_USER_EMAIL=

# === UID/GID (fix Linux bind-mount permissions) ==============================
# Fill from `id -u` / `id -g` on the host running the stack.
HOST_UID=1000
HOST_GID=1000

# === Image source =============================================================
# REQUIRED: set this to your real registry path before first run.
# Images pulled are <IMAGE_REGISTRY>:${IMAGE_TAG}, <IMAGE_REGISTRY>-squid:${IMAGE_TAG}
# and <IMAGE_REGISTRY>-symphony:${IMAGE_TAG}.
IMAGE_REGISTRY=CHANGEME.artifactory.example/opencode-workplace
# Image tag pulled for every service. Defaults to 'latest' (the moving tag
# that always points at the newest upload); pin a specific number instead for
# a reproducible unattended run.
IMAGE_TAG=latest

# === Safety switches (defaults are the safe ones; a project usually raises them) ==
# 1 enables git push/fetch/pull/clone. Symphony needs this on to push branches
# at all — see GIT_REMOTE_ALLOWLIST below and the README's "The security
# model".
ALLOW_REMOTE_GIT=0
# Whitespace- or comma-separated host/path prefixes, matched on a
# path-segment boundary. Defence in depth, not the boundary — the scoped
# token is (see the README's "The allowlists are defence in depth, not a
# boundary"). Usually set per-project instead, once ALLOW_REMOTE_GIT=1 is
# also per-project.
GIT_REMOTE_ALLOWLIST=
# 1 offers the GitLab MCP's write tools (open MRs, answer review comments) to
# the model. Off by default: the GitLab MCP is read-only until you say
# otherwise. See GITLAB_WRITE_PROJECTS below.
ALLOW_GITLAB_WRITE=0
# Comma- or whitespace-separated `group/project` prefixes the write tools may
# act on, same matching rule as GIT_REMOTE_ALLOWLIST above.
GITLAB_WRITE_PROJECTS=

# 1 force-disables a service's MCP even when its credentials are present
# (the image auto-enables each MCP when its full var set is supplied).
DISABLE_BITBUCKET_MCP=0
DISABLE_JIRA_MCP=0
DISABLE_GITLAB_MCP=0
DISABLE_JFROG_MCP=0
DISABLE_CONFLUENCE_MCP=0
DISABLE_MFILES_MCP=0
